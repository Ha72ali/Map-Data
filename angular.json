{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dashboard-angular-client": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/dashboard-angular-client",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "polyfills": [
              "zone.js"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "node_modules/@arcgis/core/assets",
                "output": "/assets/arcgis"
              },
              {
                "glob": "*.{json,geojson}",
                "input": "../data/map-geojson",
                "output": "/assets/maps"
              },
              {
                "glob": "*.{json,geojson}",
                "input": "src/assets/maps",
                "output": "/assets/maps"
              },
              {
                "glob": "**/*",
                "input": "src/assets/icons",
                "output": "/assets/icons"
              }
            ],
            "styles": [
              "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "node_modules/@arcgis/core/assets/esri/themes/light/main.css",
              "src/styles.css",
              "src/app/report-export/report-export-capture.css",
              "src/rbac-material.css"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "@arcgis/core",
              "jspdf",
              "html2canvas",
              "xlsx"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "namedChunks": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "6mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "160kb",
                  "maximumError": "300kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "dashboard-angular-client:build",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "dashboard-angular-client:build:production"
            },
            "development": {
              "buildTarget": "dashboard-angular-client:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "be431772-cdf1-4713-b8b0-b7f4e8c2854a"
  }
}
